# MCP server configuration (scripts/mcp)
# See docs/mcp.md for full setup instructions.

# Transport: "stdio" (default, spawned as a subprocess by an agent harness
# like Claude Code / Codex / Hermes Agent) or "http" (self-hosted, network
# reachable).
MCP_TRANSPORT="stdio"

# --- http transport only ---
MCP_HTTP_PORT=8787
MCP_HTTP_HOST="127.0.0.1"
# Required before binding to any host other than 127.0.0.1; without it,
# anything that can reach the port can call the server.
MCP_HTTP_ACCESS_TOKEN=""

# --- project/template/credential tools (talk to the YumCut REST API) ---
YUMCUT_API_BASE_URL="http://localhost:3000"
# Personal access token from POST /api/settings/api-tokens (shown once at creation).
YUMCUT_API_TOKEN=""

# --- stick-figure render tools (local only; no YumCut API/DB needed) ---
# Max concurrent headless-Chromium renders. Keep at 1 unless the host has
# real headroom -- each render is a full browser instance.
STICK_RENDER_CONCURRENCY=1
# Where render job records and finished mp4s are written. Defaults under
# scripts/stick-renderer/out/ if unset.
# STICK_RENDER_JOBS_DIR="scripts/stick-renderer/out/jobs"
# STICK_RENDER_OUTPUT_DIR="scripts/stick-renderer/out/renders"
# Override the headless Chromium binary if not using the pre-installed one.
# REMOTION_BROWSER_EXECUTABLE="/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell"
